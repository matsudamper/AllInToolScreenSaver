{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/setup.sh\"",
            "timeout": 900
          }
        ],
        "matcher": "startup|resume"
      }
    ]
  }
}
