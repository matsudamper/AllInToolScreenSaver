{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "extends": [":dependencyDashboard"],
  "packageRules": [
    {
      "matchManagers": ["gradle"],
      "matchPackageNames": ["/^androidx\\.test(?:[.:]|$)/"],
      "automerge": true,
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "autoApprove": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "/^actions\\//"
      ],
      "automerge": true
    }
  ],
}
